# ---------------------------------------------------------------------------
# L-SEA Space Apps - ignore rules
#
# Environment values, credentials and generated artifacts never leave the
# machine. The tracked .env.example template is explicitly re-included.
# ---------------------------------------------------------------------------

# Environment files
.env
.env.*
!.env.example

# Secrets and credentials
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
.aws/
.npmrc

# Node.js
node_modules/
npm-debug.log*
pnpm-debug.log*
.pnpm-store/
dist/
build/
.next/
out/
coverage/
.turbo/
.vercel/
.parcel-cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Logs
*.log
logs/

# Operating system and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
