# L-SEA Space Apps - static hosting configuration (Apache / GoDaddy cPanel).
#
# Vite copies this file from public/ into dist/ on every build, so it ships with
# the deployment unchanged. See docs/deployment.md for the full GoDaddy plan.
# If the cPanel plan forces its own configuration or does not allow .htaccess,
# this file is the documented fallback: disable it and apply the equivalent
# settings from cPanel instead.

Options -MultiViews

# Single-page application fallback: serve index.html for client-side routes,
# but keep real files and directories. The current build has no client-side
# router; the rule is defensive for deep links added later.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Force HTTPS once the cPanel certificate is active. The X-Forwarded-Proto guard
# avoids a redirect loop behind a TLS-terminating proxy.
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# MIME types for the pre-computed datasets.
<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/geo+json .geojson
  AddType application/octet-stream .bin
</IfModule>

# Compression for text payloads.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Caching:
# - hashed assets in /assets/ never change, so cache them for one year;
# - datasets in /data/ are replaced between builds, so cache them for one day
#   and let clients revalidate;
# - index.html must always be revalidated so a new deployment is picked up.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(json|bin|geojson)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
